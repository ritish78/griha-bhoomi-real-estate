{
  "name": "template-drizzle-typescript-zod",
  "version": "1.0.0",
  "description": "Template",
  "main": "src/index.ts",
  "scripts": {
    "test": "jest",
    "dev": "nodemon -L -e ts,js --exec ts-node -r tsconfig-paths/register ./src/index.ts",
    "bundev": "bun ./src/index.ts",
    "seed": "ts-node ./seed.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "build": "tsc && tsc-alias",
    "start": "pm2 start ./dist/index.js --no-daemon",
    "migration:generate": "drizzle-kit generate:pg --schema=./src/model",
    "migration:push": "drizzle-kit push:pg",
    "migrate": "drizzle-kit generate:pg --schema=./src/model && drizzle-kit push:pg",
    "database:studio": "drizzle-kit studio"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^6.0.0",
    "colors": "^1.4.0",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "redis": "^6.2.1",
    "slugify": "^1.6.9",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@esbuild-kit/core-utils": "3.3.2",
    "@esbuild-kit/esm-loader": "2.6.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}